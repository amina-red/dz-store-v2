# Default values for local development. Put real secrets in .env.local (never committed)
# or in the environment of your server.

APP_ENV=dev
APP_SECRET=change-me-in-env-local

# Docker Compose sets this to the "db" container. Outside Docker, point it at your own PostgreSQL.
DATABASE_URL="postgresql://dzstore:dzstore@127.0.0.1:5432/dzstore?serverVersion=16&charset=utf8"

# Orders with a subtotal at or above this amount (DA) get free delivery. 0 turns it off.
FREE_DELIVERY_FROM=10000

# Maximum orders still "new" for one phone number in 24 hours.
MAX_PENDING_PER_PHONE=3
